# ============================================================
# CONFIGURAÇÃO DO TARIFA ZERO
# ============================================================
# 
# 1. Copie este arquivo para .env:
#    cp .env.example .env
#
# 2. Obtenha sua chave gratuita em:
#    https://openrouteservice.org/dev/#/signup
#
# 3. Cole sua chave abaixo:

ORS_KEY=sua_chave_aqui

# ============================================================
# BACKEND API - NEON POSTGRESQL
# ============================================================
# 
# 1. Crie uma conta gratuita em: https://neon.tech
# 2. Crie um novo projeto
# 3. Copie a connection string e cole abaixo
# 4. Certifique-se de que PostGIS está habilitado

DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ============================================================
# VERCEL KV (REDIS) - OPCIONAL
# ============================================================
# Usado para cache de posições em tempo real
# Será configurado automaticamente pelo Vercel após deploy

# KV_URL=""
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
# KV_REST_API_READ_ONLY_TOKEN=""

# ============================================================
# CONFIGURAÇÕES GERAIS
# ============================================================

# Ambiente (development, production)
NODE_ENV=development

# URL da API (para CORS)
API_URL=http://localhost:3000

# URL do Frontend
FRONTEND_URL=http://localhost:5173
