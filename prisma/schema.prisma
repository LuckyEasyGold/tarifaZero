generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model User {
  id                String        @id @default(cuid())
  anonymousId       String        @unique
  nickname          String?
  points            Int           @default(0)
  level             Int           @default(1)
  totalTrips        Int           @default(0)
  totalPoints       Int           @default(0)
  totalMinutes      Int           @default(0)
  badges            String[]
  streak            Int           @default(0)
  lastActive        DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  acceptedTerms     Boolean       @default(false)
  acceptedTermsDate DateTime?
  currentLat        Float?
  currentLng        Float?
  isOnline          Boolean       @default(false)
  isTracking        Boolean       @default(false)
  
  // Trust Score & Reputação
  trustScore        Float         @default(0.5)
  contributions     Int           @default(0)
  
  // Relações
  trajectories      Trajectory[]

  @@index([points])
  @@index([totalPoints])
  @@index([isOnline])
  @@index([trustScore])
  @@map("users")
}

model Line {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  color            String
  colorHex         String
  startTime        String
  endTime          String
  intervalMin      Int
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  routes           Route[]
  stops            Stop[]
  trips            Trip[]
  vehiclePositions VehiclePosition[]
  wifiNetworks     WifiNetwork[]
  trajectories     Trajectory[]

  @@map("lines")
}

model Route {
  id        String       @id @default(cuid())
  lineId    String
  direction String
  name      String
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  points    RoutePoint[]
  line      Line         @relation(fields: [lineId], references: [id], onDelete: Cascade)
  trips     Trip[]

  @@unique([lineId, direction])
  @@map("routes")
}

model RoutePoint {
  id        String   @id @default(cuid())
  routeId   String
  sequence  Int
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, sequence])
  @@index([routeId])
  @@map("route_points")
}

model Stop {
  id             String          @id @default(cuid())
  lineId         String
  code           String          @unique
  name           String
  lat            Float
  lng            Float
  description    String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  line           Line            @relation(fields: [lineId], references: [id], onDelete: Cascade)
  scheduledTimes ScheduledTime[]

  @@unique([lineId, name])
  @@index([lineId])
  @@map("stops")
}

model ScheduledTime {
  id        String   @id @default(cuid())
  lineId    String
  stopId    String
  time      String // Formato HH:MM
  dayOfWeek String // 'weekday', 'saturday', 'sunday', 'holiday'
  direction String   @default("ida") // 'ida' ou 'volta'
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stop      Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([lineId, dayOfWeek])
  @@index([stopId])
  @@map("scheduled_times")
}

enum TrackStatus {
  pending
  draft
  verified
  rejected
}

model Trajectory {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  lineId          String
  line            Line        @relation(fields: [lineId], references: [id])
  direction       String      @default("ida") // ida | volta
  status          TrackStatus @default(pending)
  trustScore      Float       @default(0.5)
  points          Json        // Array de {lat, lng, speed, ts, accuracy}
  metadata        Json?       // {clientConfidence, reasons, estimatedStops, deviceType, wifiValidated}
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  verifiedAt      DateTime?

  @@index([lineId, status])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("trajectories")
}

model Trip {
  id             String    @id @default(cuid())
  lineId         String
  routeId        String
  scheduledStart DateTime
  scheduledEnd   DateTime
  actualStart    DateTime?
  actualEnd      DateTime?
  status         String    @default("scheduled")
  vehicleId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  line           Line      @relation(fields: [lineId], references: [id], onDelete: Cascade)
  route          Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([lineId, status])
  @@index([scheduledStart])
  @@map("trips")
}

model VehiclePosition {
  id         String   @id @default(cuid())
  lineId     String
  userId     String?
  lat        Float
  lng        Float
  speed      Float?
  heading    Float?
  accuracy   Float?
  confidence Float    @default(1.0)
  source     String   @default("crowdsource")
  timestamp  DateTime @default(now())
  createdAt  DateTime @default(now())
  line       Line     @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId, timestamp])
  @@index([timestamp])
  @@map("vehicle_positions")
}

model UserTrack {
  id        String   @id @default(cuid())
  userId    String
  sessionId String
  lineId    String?
  lat       Float
  lng       Float
  speed     Float?
  heading   Float?
  accuracy  Float?
  timestamp DateTime
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([userId, timestamp])
  @@index([lineId, timestamp])
  @@map("user_tracks")
}

model WifiNetwork {
  id          String   @id @default(cuid())
  lineId      String
  ssid        String?
  bssid       String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  line        Line     @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@index([ssid])
  @@map("wifi_networks")
}

model TempStop {
  id        String   @id @default(cuid())
  lineId    String
  lat       Float
  lng       Float
  sessionId String?
  name      String?
  createdAt DateTime @default(now())

  @@index([lineId])
  @@map("temp_stops")
}

// Nova tabela para armazenar trajetos gravados pelos usuários (pendentes de validação)
model UserTrajectory {
  id              String   @id @default(cuid())
  userId          String
  lineId          String
  sessionId       String
  status          String   @default("pending") // pending, verified, rejected
  points          Json     // Array de {lat, lng, speed, ts, accuracy}
  stops           Json?    // Array de {lat, lng, name, ts}
  metadata        Json?    // {deviceType, wifiValidated, clientConfidence, etc}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  verifiedAt      DateTime?
  
  @@index([lineId, status])
  @@index([userId])
  @@index([createdAt])
  @@map("user_trajectories")
}

// Nova tabela para paradas criadas pelos usuários (pendentes de validação)
model UserStop {
  id              String   @id @default(cuid())
  userId          String
  lineId          String
  trajectoryId    String?
  lat             Float
  lng             Float
  name            String
  status          String   @default("pending") // pending, verified, rejected
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  verifiedAt      DateTime?
  
  @@index([lineId, status])
  @@index([userId])
  @@index([createdAt])
  @@map("user_stops")
}

model Supporter {
  id           String   @id @default(cuid())
  name         String
  socialUrl    String?
  socialLabel  String?
  avatarUrl    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("supporters")
}

model SpeedStats {
  id           String   @id @default(cuid())
  lineId       String
  segmentStart String
  segmentEnd   String
  hourOfDay    Int
  dayOfWeek    Int
  avgSpeed     Float
  minSpeed     Float
  maxSpeed     Float
  sampleCount  Int
  lastUpdated  DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([lineId, segmentStart, segmentEnd, hourOfDay, dayOfWeek])
  @@index([lineId])
  @@map("speed_stats")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
