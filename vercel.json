{
  "installCommand": "npm install --legacy-peer-deps",
  "crons": [
    {
      "path": "/api/admin/validate-routes",
      "schedule": "0 * * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
